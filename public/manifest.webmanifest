{
  "name": "Forma — Personal AI",
  "short_name": "Forma",
  "description": "Your private, intelligent, and flexible AI workspace with interactive artifacts, python sandbox, and local privacy.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070a10",
  "theme_color": "#070a10",
  "lang": "en",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "productivity",
    "utilities",
    "developer tools"
  ],
  "shortcuts": [
    {
      "name": "New Chat",
      "url": "/?action=new",
      "description": "Start a fresh conversation in Forma"
    },
    {
      "name": "Python Sandbox",
      "url": "/?action=python",
      "description": "Launch interactive Python & data sandbox"
    }
  ]
}
